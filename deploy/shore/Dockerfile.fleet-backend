FROM python:3.11-slim

WORKDIR /app

COPY packages/fleet-view/backend/pyproject.toml .
RUN pip install --no-cache-dir \
    fastapi>=0.111 \
    "uvicorn[standard]>=0.30" \
    "sqlalchemy[asyncio]>=2.0" \
    asyncpg>=0.29 \
    psycopg2-binary>=2.9 \
    alembic>=1.13 \
    pydantic>=2.7 \
    httpx>=0.27 \
    "python-jose[cryptography]>=3.3"

COPY packages/fleet-view/backend/src/ /app/src/

ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uvicorn", "fleet_backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
